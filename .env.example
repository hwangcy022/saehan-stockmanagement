# Supabase 프로젝트 설정 → Project Settings → API 에서 복사
# (로컬 supabase start 를 쓰면 `supabase status` 출력의 API URL / anon key)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...   # anon (public) key 또는 sb_publishable_... 키

# --- 아래는 scripts/smoke.mjs(자동 점검) 전용. 웹앱 동작에는 필요 없음 ---
# SMOKE_ADMIN_EMAIL=admin@saehan.local
# SMOKE_ADMIN_PASSWORD=admin1234
# SMOKE_VIEWER_EMAIL=viewer@saehan.local
# SMOKE_VIEWER_PASSWORD=viewer1234
